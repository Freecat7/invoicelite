# Port, auf dem die Anwendung im Container lauscht
PORT=3000

# Datenverzeichnis im Container (SQLite-Datei + Uploads). Als Volume mounten!
DATA_DIR=/data

# Erstes Administratorkonto - wird nur beim allerersten Start angelegt.
# Ohne ADMIN_PASSWORD wird ein Zufallspasswort erzeugt und im Log ausgegeben.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Signiert die Sitzungs-Cookies. Leer lassen: wird einmalig erzeugt und
# unter $DATA_DIR/.jwt-secret gespeichert.
JWT_SECRET=

# Zeitzone fuer den naechtlichen Lauf der wiederkehrenden Belege
TZ=Europe/Berlin

# Auf "true" setzen, um den automatischen Lauf zu deaktivieren
DISABLE_SCHEDULER=false
